{
  "name": "gov-view",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run data && next dev",
    "build": "npm run data && next build --webpack",
    "postbuild": "node scripts/secure-export.mjs",
    "data": "node --experimental-strip-types scripts/build-data.ts",
    "metrics": "node --experimental-strip-types scripts/report-metrics.ts",
    "collect": "node --experimental-strip-types scripts/collect.ts",
    "discover:india": "node --experimental-strip-types scripts/discover-employment-news.ts",
    "review:packet": "node --experimental-strip-types scripts/review-packet.ts",
    "review:sheet": "node --experimental-strip-types scripts/review-sheet.ts",
    "geo": "node scripts/build-geo.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --experimental-strip-types --test --test-concurrency=1 \"lib/**/*.test.ts\" \"connectors/**/*.test.ts\" \"scripts/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "postinstall": "node scripts/copy-cesium-assets.mjs",
    "prepare:cesium": "node scripts/copy-cesium-assets.mjs"
  },
  "dependencies": {
    "cesium": "1.145.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3"
  }
}
