# Only needed to run the collector locally. On GitHub, add these as repository secrets.
# Free key: https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Show demo records instead of published data (for UI work).
NEXT_PUBLIC_DEMO=
# Serve from a sub-path, e.g. /gov-view for a GitHub Pages project site.
NEXT_PUBLIC_BASE_PATH=
# HTTPS origin for canonical page URLs, without any path (e.g. https://name.pages.dev).
NEXT_PUBLIC_SITE_ORIGIN=
# Full deployed site base URL for RSS/Atom links (same as origin when hosted at /).
NEXT_PUBLIC_SITE_URL=
